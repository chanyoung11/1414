{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "app",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/dates",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/remind",
      "schedule": "0 1 * * *"
    }
  ]
}
