# Neon 연결 문자열 (Vercel Neon 통합을 붙이면 DATABASE_URL이 자동으로 들어옵니다)
DATABASE_URL=postgres://user:pass@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 세션 쿠키 서명 키. 16자 이상 아무 문자열. 예: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Vision API 키 (악보 코드 인식). 없으면 인식 기능만 꺼지고 나머지는 동작. 'mock' 이면 테스트용 가짜 결과
GOOGLE_VISION_KEY=
